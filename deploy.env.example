# Optional per-server settings for ./deploy.sh.
#
#   cp deploy.env.example deploy.env      (on the server, once)
#
# then remove the leading "#" from the lines you want. Lines that start with "#" are ignored.
# deploy.env is ignored by git, so editing it never blocks a deploy. Put the "#" back to undo.
# Do not put secrets here.

# Bring back the "API key" sign-in tab (web builds hide it by default), e.g. while PIA is down:
# ENABLE_API_KEY_LOGIN=true

# Where nginx serves the dashboard from, and the URL the deploy checks afterwards:
# WEB_ROOT=/home/ubuntu/typesense-dashboard/dist/spa
# VERIFY_URL=https://typesense.printo.in/dashboard/

# Addresses and sign-in settings baked into the build (the defaults are the Printo ones):
# PIA_API_URL=/pia/api/v1
# TYPESENSE_API_URL=https://typesense.printo.in/v1
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
